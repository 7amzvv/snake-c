{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Installer raylib",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/setup-raylib.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Compiler Snake",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-pedantic",
                "main.c",
                "-Ilib/raylib/include",
                "-Llib/raylib/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-o",
                "snake.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Jouer",
            "type": "process",
            "command": "${workspaceFolder}/snake.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Compiler Snake",
            "problemMatcher": []
        },
        {
            "label": "Compiler les tests",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-pedantic",
                "tests/test_snake.c",
                "-Ilib/raylib/include",
                "-Llib/raylib/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-o",
                "build/test_snake.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Tester Snake",
            "type": "process",
            "command": "${workspaceFolder}/build/test_snake.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Compiler les tests",
            "problemMatcher": []
        }
    ]
}
