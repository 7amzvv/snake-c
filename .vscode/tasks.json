{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compiler Snake",
            "type": "process",
            "command": "C:\\mingw64\\mingw64\\bin\\gcc.exe",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "main.c",
                "-Ilib/raylib/include",
                "-Llib/raylib/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-o",
                "snake.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
